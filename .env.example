# Copy to .env and fill in real values. .env is gitignored - never commit it.
DB_PASSWORD=change-me
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# IANA timezone for the container, so the weekly cron (Mon 03:00) fires in
# the timezone you actually expect rather than UTC. e.g. Europe/Berlin
TZ=UTC
# Host port for the nginx service (serves docs/ and proxies /api/ to the
# backend). Change this if 8087 is already taken on your host.
WEB_PORT=8087
